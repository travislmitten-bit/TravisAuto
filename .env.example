KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here
DRY_RUN=true
DASH_REFRESH=30
TAOSTATS_API_KEY=your_taostats_key_here
LUNARCRUSH_API_KEY=
GLASSNODE_API_KEY=
PAIRS=XBTUSD,SOLUSD,TAOUSD,LINKUSD
INTERVAL=240

# Per-pair regime overrides (optional) — bypass auto-detection
# XBTUSD_REGIME_OVERRIDE=BULL
# SOLUSD_REGIME_OVERRIDE=BULL
# TAOUSD_REGIME_OVERRIDE=BULL
# LINKUSD_REGIME_OVERRIDE=BULL

# One-shot SELL→BUY live order test (auto-disables after running)
TEST_TRADE=false

# Telegram alerts — see notifications/telegram.py for setup instructions
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
